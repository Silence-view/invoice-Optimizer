# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,cjs,mjs,css,html,json,yml,yaml,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

# Hash-pinned templates and frozen evidence: never reformat.
[{src/invoice_optimizer/templates/**,output/**}]
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

# Copying this file does not generate secrets; prefer scripts/bootstrap.py, which
# writes DATABASE_URL and POSTGRES_PASSWORD from one generated password.
DATABASE_URL=postgresql+psycopg://invoice:REPLACE_WITH_POSTGRES_PASSWORD@127.0.0.1:55432/invoice_optimizer
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_SECRET
# Optional read replica / reporting DSN (empty uses DATABASE_URL)
DATABASE_READ_URL=
# Shared read-only console token
INVOICE_API_TOKEN=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# One-time first-administrator secret, separate from INVOICE_API_TOKEN; rejected once
# an operator exists. Empty falls back to INVOICE_API_TOKEN (not recommended).
INVOICE_SETUP_TOKEN=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
INVOICE_DATA_DIR=var
INVOICE_ACTOR=local-reviewer
INVOICE_SYNTHETIC=1
# simulated (local only), gmail (test mode, see INVOICE_MAIL_REDIRECT) or smtp
INVOICE_PROVIDER=simulated
INVOICE_AUTO_CLOSE=1
INVOICE_AUTO_DISPATCH=1
INVOICE_BATCH_SIZE=1000
INVOICE_WORKER_BATCH_SIZE=500
INVOICE_POLL_SECONDS=2
INVOICE_TEX_COMPILER=pdflatex
# Invoice format profile for newly frozen drafts (docs/INVOICE_FORMATS.md)
INVOICE_FORMAT_PROFILE=default
INVOICE_PROFILE_DIR=config/invoice_profiles
# An https:// public base URL always sets Secure cookies and HSTS; non-synthetic mode
# refuses to start without one. INVOICE_SECURE_COOKIES=1 also forces Secure on loopback HTTP.
INVOICE_PUBLIC_BASE_URL=http://127.0.0.1:8765
INVOICE_SECURE_COOKIES=0
INVOICE_GMAIL_EXPECTED_EMAIL=
INVOICE_ALLOWED_EMAIL_DOMAINS=example.test
# Real email is test-only: 'connected' redirects every real message to the
# connected Gmail account ('off' is refused while INVOICE_SYNTHETIC=1).
# INVOICE_PROVIDER=gmail sends INVOICE_MAIL_SEND_KINDS through Gmail (docs/GMAIL_SETUP.md).
INVOICE_MAIL_REDIRECT=connected
INVOICE_MAIL_SEND_KINDS=INVOICE,DIGEST,TEST
INVOICE_OPERATOR_EMAIL=operations@example.test
# Daily "N invoices await approval" reminder after month-end preparation
INVOICE_APPROVAL_DIGEST=1
# Automatic data refresh: poll var/inbox (0 disables); synthetic demo feed
# (0 disables; scripts/run_local.py defaults it to 900 seconds)
INVOICE_INBOX_SECONDS=30
INVOICE_INBOX_MAX_FILES=4
INVOICE_DEMO_FEED_SECONDS=0
INVOICE_DEMO_FEED_ROWS=300
# SMTP provider only (INVOICE_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Database pool and server-side timeouts, per process (0 disables a timeout)
INVOICE_DB_POOL_SIZE=4
INVOICE_DB_MAX_OVERFLOW=2
INVOICE_DB_POOL_RECYCLE_SECONDS=1800
INVOICE_DB_STATEMENT_TIMEOUT_MS=0
INVOICE_DB_LOCK_TIMEOUT_MS=0
INVOICE_DB_IDLE_TX_TIMEOUT_MS=0
# scripts/local_postgres.sh only
INVOICE_PG_BIN=/opt/homebrew/opt/postgresql@15/bin
INVOICE_PG_PORT=55432
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
